# Database Configuration
MONGO_URI=mongodb://localhost:27017/rainbow_education

# JWT Configuration
ACCESS_TOKEN_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random
ACCESS_TOKEN_LIFE=1d
JWT_COOKIE_EXPIRES_IN=90

# Email Configuration (Gmail)
AUTH_EMAIL=your_email@gmail.com
AUTH_PASSWORD=your_app_password_from_gmail

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GG_CLIENT_ID=your_google_client_id_here

# Server Configuration
PORT=4000
NODE_ENV=development

# Client URL
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:4000

# Payment Gateway Configuration (Optional - for future use)
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_SECRET_KEY=your_vnpay_secret_key
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment/vnpay/return

MOMO_PARTNER_CODE=your_momo_partner_code
MOMO_ACCESS_KEY=your_momo_access_key
MOMO_SECRET_KEY=your_momo_secret_key
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:3000/payment/momo/return
MOMO_IPN_URL=http://localhost:4000/api/payment/momo/ipn

ZALOPAY_APP_ID=your_zalopay_app_id
ZALOPAY_KEY1=your_zalopay_key1
ZALOPAY_KEY2=your_zalopay_key2
ZALOPAY_ENDPOINT=https://sandbox.zalopay.com.vn/v001/tpe/createorder
ZALOPAY_CALLBACK_URL=http://localhost:3000/payment/zalopay/callback

STRIPE_SECRET_KEY=your_stripe_secret_key

# Hugging Face API Configuration (MIỄN PHÍ)
# Đăng ký tại: https://huggingface.co/settings/tokens
HF_API_KEY=your_huggingface_token_here

# Hoặc dùng demo key (không cần đăng ký)
# HF_API_KEY=hf_demo